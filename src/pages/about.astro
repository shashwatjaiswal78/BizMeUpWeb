---
/** About: founder story expanded from the homepage note, how BizMeUp works, values. */
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderNote from '../components/home/FounderNote.astro';
import Process from '../components/home/Process.astro';
import Tape from '../components/ui/Tape.astro';
import CtaBand from '../components/ui/CtaBand.astro';

const values = [
  { title: '[Value 1]', text: '[One line on what this means for clients]', bg: 'bg-mustard text-espresso', rotate: -1.5, tape: 'rgba(255,255,255,0.6)' },
  { title: '[Value 2]', text: '[One line on what this means for clients]', bg: 'bg-blue text-white', rotate: 1.5, tape: 'rgba(253,246,236,0.7)' },
  { title: '[Value 3]', text: '[One line on what this means for clients]', bg: 'bg-white text-espresso', rotate: -1, tape: 'rgba(244,185,66,0.55)' },
];
---

<BaseLayout
  title="About BizMeUp | Marketing and websites in Mohali and Chandigarh"
  description="BizMeUp is a small marketing and digital execution studio in Mohali and Chandigarh, founded by Shashwat Jaiswal. You work with the people actually doing the work."
  image="/og/about.png"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
>
  <section class="bg-cream px-5 pt-32 pb-20 md:px-10 lg:px-16 lg:pt-44 lg:pb-28">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-10">
      <h1 class="m-0 max-w-[1100px] font-display text-[clamp(48px,7vw,112px)] leading-[0.9] font-extrabold tracking-[-0.045em] text-espresso">
        Turning Business Challenges into Success Stories
      </h1>
      <p class="m-0 max-w-[760px] font-serif text-[clamp(26px,2.6vw,38px)] leading-[1.3] text-espresso-soft italic">
        You've built something good. Nobody's seeing it. That's the part we fix.
      </p>
    </div>
  </section>

  <FounderNote>
    <p class="m-0 max-w-[560px] text-[19px] leading-[1.6]">[Founder story, expanded: how BizMeUp started and why.]</p>
    <p class="m-0 max-w-[560px] text-[19px] leading-[1.6]">[Founder story, expanded: the kind of businesses BizMeUp helps.]</p>
  </FounderNote>

  <Process title="How BizMeUp works." />

  <section class="bg-cream px-5 py-24 md:px-10 lg:px-16 lg:py-40">
    <div class="mx-auto max-w-[1280px]">
      <h2 class="m-0 border-t-2 border-espresso pt-10 font-display text-[clamp(40px,5vw,76px)] leading-[0.95] font-extrabold tracking-[-0.035em] text-espresso">
        What we stand for.
      </h2>
      <ul class="mt-16 grid list-none grid-cols-1 gap-11 p-0 md:grid-cols-3">
        {
          values.map((v) => (
            <li class:list={['relative flex min-h-[260px] flex-col justify-between gap-6 rounded-[6px] p-[34px]', v.bg]} style={`transform:rotate(${v.rotate}deg);box-shadow:var(--shadow-poster)`}>
              <Tape color={v.tape} rotate={-3} style="top:-12px;left:34px" />
              <h3 class="m-0 font-display text-[44px] leading-[0.95] font-extrabold tracking-[-0.035em]">{v.title}</h3>
              <p class="m-0 text-base leading-normal">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
