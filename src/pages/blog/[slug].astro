---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { getPosts, formatDate, type Post } from '../../lib/content';
import { articleSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: d.title }];
---

<BaseLayout
  title={`${d.title} | BizMeUp`}
  description={d.description}
  type="article"
  image={`/og/blog/${post.id}.png`}
  breadcrumbs={crumbs}
  schema={[articleSchema(post, Astro.site)]}
>
  <article>
    <header class="bg-cream px-5 pt-32 pb-12 md:px-10 lg:px-16 lg:pt-44 lg:pb-16">
      <div class="mx-auto flex max-w-[860px] flex-col gap-6">
        <Breadcrumbs items={crumbs} />
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted">
          <time datetime={d.publishedAt.toISOString()}>{formatDate(d.publishedAt)}</time>
          {d.tags.map((t) => <span class="rounded-full bg-cream-deep px-3 py-1 font-semibold text-espresso-soft">{t}</span>)}
        </div>
        <h1 class="m-0 font-display text-[clamp(44px,6vw,88px)] leading-[0.92] font-extrabold tracking-[-0.045em] text-espresso">
          {d.title}
        </h1>
        <p class="m-0 text-[clamp(19px,1.8vw,24px)] leading-[1.45] text-espresso-soft">{d.description}</p>
      </div>
    </header>

    {
      d.cover && (
        <div class="bg-cream px-5 md:px-10 lg:px-16">
          <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1280, 1720]} sizes="(min-width: 1024px) 1100px, 92vw" class="mx-auto block aspect-[16/9] w-full max-w-[1100px] rounded-[8px] object-cover" loading="eager" />
        </div>
      )
    }

    <div class="post-body bg-cream px-5 py-16 md:px-10 lg:px-16 lg:py-24">
      <div class="mx-auto max-w-[860px]">
        <div class="max-w-[760px]">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .post-body :global(h2) {
    margin: 56px 0 16px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 3vw, 44px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-espresso);
  }
  .post-body :global(h3) {
    margin: 36px 0 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    color: var(--color-espresso);
  }
  .post-body :global(p),
  .post-body :global(li) {
    font-size: 19px;
    line-height: 1.65;
  }
  .post-body :global(p) {
    margin: 0 0 20px;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 20px;
    padding-left: 1.4em;
  }
  .post-body :global(ul) {
    list-style: disc;
  }
  .post-body :global(ol) {
    list-style: decimal;
  }
  .post-body :global(blockquote) {
    margin: 32px 0;
    padding-left: 24px;
    border-left: 3px solid var(--color-mustard);
    font-size: 22px;
  }
  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>
