---
/**
 * Social app tiles floating around the hero scene. They sit under the orange veil,
 * so in the dark they are found with the spotlight; when the lights come on they pop
 * in one by one. Each tile bobs on its own rhythm and, on desktop, drifts with the
 * pointer at a different depth. Decorative only. Reduced motion: still and visible.
 */
// Inlined (not <img>) so the tiles cost no requests and are never the page's LCP element.
import instagramRaw from '../../assets/social-logos/tile/instagram.svg?raw';
import whatsappRaw from '../../assets/social-logos/tile/whatsapp.svg?raw';
import youtubeRaw from '../../assets/social-logos/tile/youtube.svg?raw';

/** Decorative inline SVG: hidden from assistive tech, with ids prefixed so gradients never clash. */
const inline = (svg: string, prefix: string) =>
  svg
    .replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true" focusable="false"')
    .replace(/id="([^"]+)"/g, `id="${prefix}-$1"`)
    .replace(/url\(#([^)]+)\)/g, `url(#${prefix}-$1)`);
const instagram = inline(instagramRaw, 'ig');
const whatsapp = inline(whatsappRaw, 'wa');
const youtube = inline(youtubeRaw, 'yt');

// Positions are percentages of the scene; depth sets how far each drifts with the pointer.
const logos: {
  svg: string;
  top: string;
  left: string;
  size: number;
  rotate: number;
  depth: number;
  float: number;
  delay: number;
  badge: 'likes' | 'count' | null;
}[] = [
  // Three tiles in a triangle around the composition (top left, top right, right middle), popping in in that order.
  { svg: youtube, top: '-2%', left: '-3%', size: 76, rotate: -9, depth: 0.6, float: 6.2, delay: 0, badge: null },
  { svg: instagram, top: '-3%', left: '54%', size: 92, rotate: 8, depth: 1, float: 5.4, delay: 0.1, badge: 'likes' },
  { svg: whatsapp, top: '42%', left: '91%', size: 84, rotate: -8, depth: 0.8, float: 6.6, delay: 0.2, badge: 'count' },
];
---

{
  logos.map((l) => (
    <div
      class="float-logo pointer-events-none absolute z-[4] left-(--left)"
      style={`top:${l.top};--left:${l.left};--size:${l.size}px;--r:${l.rotate}deg;--depth:${l.depth};--float:${l.float}s;--delay:${l.delay}s`}
    >
      <div class="float-logo-pop">
        <div class="float-logo-bob relative">
          <span class="float-logo-img block" set:html={l.svg} />
          {l.badge === 'likes' && (
            <span class="absolute -top-2.5 -right-7 inline-flex items-center gap-1 rounded-full bg-orange-deep px-2 py-1 text-xs leading-none font-bold whitespace-nowrap text-cream shadow-[0_6px_12px_rgba(25,25,25,0.25)]">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 4.3 2.4.7-1.2 2.2-2.4 4.3-2.4 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z" /></svg>
              1.2K
            </span>
          )}
          {l.badge === 'count' && (
            <span class="absolute -top-2 -right-2 inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-orange-deep px-1.5 text-[13px] leading-none font-bold text-cream shadow-[0_6px_12px_rgba(25,25,25,0.25)]">
              3
            </span>
          )}
        </div>
      </div>
    </div>
  ))
}

<style>
  .float-logo {
    /* Keep full size even when placed near the scene's right edge. */
    width: max-content;
    /* Pointer parallax: --mx/--my (-1 to 1) are set on the hero by the spotlight script. */
    transform: translate3d(calc(var(--mx, 0) * var(--depth) * 14px), calc(var(--my, 0) * var(--depth) * 10px), 0);
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .float-logo-img :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .float-logo-img {
    max-width: none;
    width: var(--size);
    height: var(--size);
    filter: drop-shadow(0 12px 18px rgba(25, 25, 25, 0.28));
  }
  .float-logo-bob {
    transform: rotate(var(--r));
    animation: logo-bob var(--float) ease-in-out infinite;
    animation-delay: calc(var(--delay) * -10);
  }
  @keyframes logo-bob {
    0%,
    100% {
      transform: rotate(var(--r)) translate3d(0, 0, 0);
    }
    50% {
      transform: rotate(calc(var(--r) * -0.4)) translate3d(0, -10px, 0);
    }
  }

  /* Lights on: each tile pops in, one after another. */
  :global(.hero[data-lit='true']) .float-logo-pop {
    animation: logo-pop 650ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--delay) + 0.15s);
  }
  @keyframes logo-pop {
    from {
      transform: scale(0.3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-logo,
    .float-logo-bob,
    :global(.hero[data-lit='true']) .float-logo-pop {
      animation: none;
      transition: none;
      transform: none;
    }
    .float-logo-bob {
      transform: rotate(var(--r));
    }
  }
</style>
