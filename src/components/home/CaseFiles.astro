---
/**
 * Case Files (CLAUDE.md 4.6).
 * All breakpoints: peek carousel with prev/next arrows.
 * Track padding creates the peek — adjacent cards show ~14px (mobile) to ~54px (desktop).
 * Card content aligns with the header above (both use the same horizontal gutter).
 */
import { getCollection } from 'astro:content';
import CaseCard from '../ui/CaseCard.astro';
import Button from '../ui/Button.astro';

const cases = (await getCollection('case-studies', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const total = cases.length;
---

<section id="work" class="case-files overflow-hidden bg-blue py-12 text-cream lg:py-[60px]" data-total={total}>
  <div class="case-wrap">
    <div class="case-head mb-10 flex flex-wrap items-end justify-between gap-6 px-5 md:px-10 lg:mb-14 lg:px-16">
      <div class="flex flex-col gap-4">
        <h2
          class="case-title m-0 font-display text-[clamp(48px,7vw,112px)] leading-[0.9] font-extrabold tracking-[-0.045em] text-cream"
        >
          The Case Files.
        </h2>
        <p class="m-0 text-[19px] text-white sm:text-[21px]">Real businesses. Real problems. Lights&nbsp;on.</p>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-3.5 text-[15px] text-white">
          <span class="case-label" aria-live="polite">Case 1 of {total}</span>
          <div class="h-[3px] w-40 bg-cream/20">
            <div class="case-bar h-[3px] w-full origin-left bg-mustard" style={`transform:scaleX(${1 / total})`}></div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="case-prev flex h-10 w-10 items-center justify-center rounded-full border border-cream/40 bg-transparent text-cream transition-colors hover:bg-cream/10 disabled:opacity-30"
            aria-label="Previous case"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M11 14L6 9l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="case-next flex h-10 w-10 items-center justify-center rounded-full border border-cream/40 bg-transparent text-cream transition-colors hover:bg-cream/10 disabled:opacity-30"
            aria-label="Next case"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M7 4l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!--
      px-5/10/16 on the track = the section gutter.
      Each slide is w-full (= track content width = viewport - 2×gutter).
      Adjacent slides peek in from the edges by gutter minus half-gap:
        mobile  ~14px  (20px gutter − 3px)
        desktop ~54px  (64px gutter − 10px)
      scroll-pl aligns snap-start with the card's left edge.
    -->
    <div
      class="case-track flex snap-x snap-mandatory gap-3 overflow-x-auto pb-3 px-5 scroll-pl-5 sm:gap-4 md:px-10 md:scroll-pl-10 lg:gap-5 lg:px-16 lg:scroll-pl-16"
    >
      {cases.map((entry, i) => (
        <div class="case-slide shrink-0 w-full snap-start">
          <CaseCard entry={entry} index={i} />
        </div>
      ))}
    </div>

    <div class="mt-8 px-5 md:px-10 lg:mt-7 lg:px-16">
      <Button href="/work" variant="cream">See all our work</Button>
    </div>
  </div>
</section>

<style>
  .case-track {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .case-track::-webkit-scrollbar {
    display: none;
  }
  .case-slide {
    transition: opacity 250ms ease;
  }

  @media (min-width: 900px) {
    .case-head {
      margin-bottom: clamp(20px, 4svh, 56px);
    }
    .case-head > div:first-child {
      gap: clamp(6px, 1.4svh, 16px);
    }
    .case-title {
      font-size: clamp(48px, min(7vw, 11svh), 112px);
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.case-files');
  const track = section?.querySelector<HTMLElement>('.case-track');
  const label = section?.querySelector<HTMLElement>('.case-label');
  const bar = section?.querySelector<HTMLElement>('.case-bar');
  const slides = Array.from(section?.querySelectorAll<HTMLElement>('.case-slide') ?? []);
  const prevBtn = section?.querySelector<HTMLButtonElement>('.case-prev');
  const nextBtn = section?.querySelector<HTMLButtonElement>('.case-next');

  if (section && track && label && bar && slides.length) {
    const total = slides.length;
    let active = -1;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      label.textContent = `Case ${i + 1} of ${total}`;
      bar.style.transform = `scaleX(${(i + 1) / total})`;
      slides.forEach((s, j) => (s.style.opacity = j === i ? '1' : '0.6'));
      if (prevBtn) prevBtn.disabled = i === 0;
      if (nextBtn) nextBtn.disabled = i === total - 1;
    };

    // Slide 0's offsetLeft = the track's left padding. Use it as the anchor
    // so goTo works without needing to read scroll-padding from computed style.
    const anchor = () => slides[0]?.offsetLeft ?? 0;

    const goTo = (i: number, smooth = true) => {
      const idx = Math.max(0, Math.min(total - 1, i));
      const slide = slides[idx];
      if (!slide) return;
      track.scrollTo({ left: slide.offsetLeft - anchor(), behavior: smooth ? 'smooth' : 'instant' });
    };

    const fromScroll = () => {
      const target = track.scrollLeft + anchor();
      let best = 0;
      let bestDist = Infinity;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slide.offsetLeft - target);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      setActive(best);
    };

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          fromScroll();
          ticking = false;
        });
      },
      { passive: true },
    );

    prevBtn?.addEventListener('click', () => goTo(active - 1));
    nextBtn?.addEventListener('click', () => goTo(active + 1));

    section.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(active - 1);
      if (e.key === 'ArrowRight') goTo(active + 1);
    });

    setActive(0);
  }
</script>
