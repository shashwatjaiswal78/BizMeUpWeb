---
/**
 * Why choose us (added after Process at the client's request). White background.
 * Six reasons on white tiles that match the service posters: 6px corners and a soft drop shadow,
 * no outline. Each has a small line icon in a brand-colour circle. Static (no motion). Descriptions are drafts for review.
 */
const reasons = [
  {
    title: 'Live in 3 weeks',
    text: 'Most websites go from kick-off to launch in about 21 days. No months-long projects, no loose timelines.',
    tone: 'orange',
    icon: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>',
  },
  {
    title: 'Fixed-price quotes',
    text: 'Websites from ₹15K, written quote before we start. No surprise invoices, no hidden extras.',
    tone: 'mustard',
    icon: '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  },
  {
    title: 'Updates on WhatsApp',
    text: 'Regular progress updates sent before you have to ask, straight to your phone.',
    tone: 'blue',
    icon: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.6A8 8 0 1 1 21 12z"/><circle cx="8.5" cy="12" r="1" fill="currentColor"/><circle cx="12.5" cy="12" r="1" fill="currentColor"/><circle cx="16.5" cy="12" r="1" fill="currentColor"/>',
  },
  {
    title: 'You work with us directly',
    text: 'No account managers, no hand-offs. The people doing the work are the people you talk to.',
    tone: 'mustard',
    icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.6 0 4.5 1.8 4.5 4.5"/>',
  },
];

const tones: Record<string, string> = {
  orange: 'bg-orange text-espresso',
  mustard: 'bg-mustard text-espresso',
  blue: 'bg-blue text-white',
};
---

<section id="why-us" class="bg-cream px-5 pt-12 pb-10 text-espresso md:px-10 lg:px-16 lg:pt-16 lg:pb-[50px]">
  <div class="mx-auto max-w-[1280px]">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6 lg:mb-16">
      <h2 class="m-0 max-w-[760px] font-display text-[clamp(40px,5vw,76px)] leading-[0.95] font-extrabold tracking-[-0.035em]">
        Why choose BizMeUp.
      </h2>
      <p class="m-0 max-w-[360px] text-lg leading-normal text-espresso-soft">
        Small on purpose, serious about standards. Here’s what working with us feels like.
      </p>
    </div>

    <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:gap-7">
      {
        reasons.map((r) => (
          <li class="why-tile flex flex-col gap-4 rounded-[6px] bg-white p-6 sm:p-7">
            <span aria-hidden="true" class:list={['inline-flex h-14 w-14 items-center justify-center rounded-full', tones[r.tone]]}>
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
            </span>
            <h3 class="m-0 mt-2 font-display text-[26px] leading-[1.05] font-extrabold tracking-[-0.02em] sm:text-[28px]">{r.title}</h3>
            <p class="m-0 text-[17px] leading-normal text-espresso-soft">{r.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Same soft drop shadow as the service posters. */
  .why-tile {
    box-shadow: var(--shadow-poster);
  }
</style>
