---
/**
 * Stat bar (replaces the industries marquee). Four "3D" tiles straddling the seam between the cream
 * hero and the Manifesto: white, a 1.5px espresso outline and a solid espresso offset shadow,
 * the site's printed, extruded poster look. On desktop the row rises 40px into the hero's bottom
 * padding so it peeks above the fold (only on screens at least 800px tall: shorter ones have less hero
 * padding to spare). Phones: a 2 x 2 grid of equal tiles. Static (no motion).
 */
const stats = [
  { value: '5+', label: 'Years' },
  { value: '40+', label: 'Clients' },
  { value: '120+', label: 'Projects delivered' },
  { value: '₹1 Cr', label: 'In ad spends' },
];
---

<section aria-label="BizMeUp in numbers" class="stat-bar relative z-10 px-5 pt-4 pb-6 md:px-10 lg:px-16 lg:py-0 lg:[@media(min-height:800px)]:-mt-10">
  <ul class="mx-auto m-0 grid max-w-[1280px] list-none auto-rows-fr grid-cols-2 gap-3.5 p-0 sm:gap-5 lg:grid-cols-4 lg:gap-6">
    {
      stats.map((stat) => (
        <li class="stat-tile flex flex-col justify-center gap-1 rounded-[14px] border-[1.5px] border-espresso bg-white px-5 py-4 sm:px-6 lg:py-5">
          <span class="font-display text-[34px] leading-none font-extrabold tracking-[-0.035em] text-espresso sm:text-[44px]">
            {stat.value}
          </span>
          <span class="text-sm font-semibold text-muted sm:text-[15px]">{stat.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Desktop: split background, cream (the hero) above the tiles' midline and white (the Manifesto) below,
     so the single row of tiles sits on the seam between the two sections. */
  .stat-bar {
    background: var(--color-cream); /* phones and tablets: two rows, so the tiles stay with the hero */
  }
  @media (min-width: 1024px) {
    .stat-bar {
      background: linear-gradient(var(--color-cream) 50%, var(--color-white) 50%);
    }
  }
  /* The extrusion: a solid offset shadow, plus a soft drop shadow so the tile also floats. */
  .stat-tile {
    box-shadow:
      5px 5px 0 var(--color-espresso),
      0 18px 30px rgba(25, 25, 25, 0.12);
  }
  @media (min-width: 640px) {
    .stat-tile {
      box-shadow:
        7px 7px 0 var(--color-espresso),
        0 22px 36px rgba(25, 25, 25, 0.14);
    }
  }
</style>
