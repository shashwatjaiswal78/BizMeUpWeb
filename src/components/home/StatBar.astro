---
/**
 * Stat bar (replaces the industries marquee). One floating white bar straddling the seam between the
 * cream hero and the Manifesto: 6px corners and the posters' soft drop shadow (no outline), and the four stats divided by
 * near-invisible lines (espresso at 10%). Desktop: one row of four; phones and tablets: a 2 x 2 grid.
 * On desktop screens at least 800px tall the bar rises 40px into the hero's bottom padding so it peeks
 * above the fold. Static (no motion).
 */
const stats = [
  { value: '5+', label: 'Years in business' },
  { value: '40+', label: 'Clients' },
  { value: '120+', label: 'Projects delivered' },
  { value: '₹1 Cr+', label: 'Ad spend managed' },
];
---

<section
  aria-label="BizMeUp in numbers"
  class="stat-bar relative z-10 bg-cream px-5 pt-4 pb-6 md:px-10 lg:bg-[linear-gradient(var(--color-cream)_50%,var(--color-white)_50%)] lg:px-16 lg:py-0 lg:[@media(min-height:800px)]:-mt-10"
>
  <!-- Desktop: the background splits cream over white exactly at the bar's midline, so it sits on the seam. -->
  <ul
    class="m-0 mx-auto grid max-w-[1280px] list-none grid-cols-2 overflow-hidden rounded-[6px] bg-white p-0 shadow-[var(--shadow-poster)] lg:grid-cols-4"
  >
    {
      stats.map((stat, i) => (
        <li
          class:list={[
            'flex flex-col items-center justify-center gap-1 border-espresso/10 px-4 py-5 text-center lg:py-6',
            i % 2 === 1 && 'max-lg:border-l',
            i >= 2 && 'max-lg:border-t',
            i > 0 && 'lg:border-l',
          ]}
        >
          <span class="font-display text-[34px] leading-none font-extrabold tracking-[-0.035em] text-espresso sm:text-[44px]">
            {stat.value}
          </span>
          <span class="text-sm font-semibold text-muted sm:text-[15px]">{stat.label}</span>
        </li>
      ))
    }
  </ul>
</section>
