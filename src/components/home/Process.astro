---
/**
 * Process (CLAUDE.md 4.8), animated at the client's request. Reused on inner pages with a different title.
 *
 * Each step has an illustration on a cream "sticker" (Spot: a magnifier finds a shop; Plan: a checklist
 * gets ticked; Build: a page assembles in a browser; Blow up: a rocket lifts off) and a numbered node
 * on a track. Desktop: the track fills left to right, scrubbed by scroll, and each step "lights up" as
 * the fill reaches its node: the node fills, the sticker pops in and its scene plays, then settles into
 * a small idle loop. Below 1024px the steps form a vertical timeline (a rail on the left joins nodes 1 to 4,
 * each sticker and its copy sit to the right) and each step lights up and fills its rail segment as it scrolls in.
 * Without JS or with reduced motion every step shows in its finished state, with no motion.
 * Idle loops pause while the section is off screen. Animations use transform and opacity only;
 * staggers come from a --d (delay) custom property on each animated part.
 */
interface Props {
  title?: string;
}

const { title = 'Spot. Plan. Build. Blow up.' } = Astro.props;

const steps = [
  { key: 'spot', title: 'Spot.', text: 'We find what’s keeping you invisible.' },
  { key: 'plan', title: 'Plan.', text: 'A strategy built around your customers.' },
  { key: 'build', title: 'Build.', text: 'Website, content and campaigns, done properly.' },
  { key: 'blow', title: 'Blow up.', text: 'Launch, measure and scale what works.' },
];
const rows = [36, 54, 72];
---

<section class="process bg-mustard px-5 pt-16 pb-12 text-espresso md:px-10 lg:px-16 lg:pt-20 lg:pb-14">
  <div class="mx-auto max-w-[1280px]">
    <h2 class="m-0 text-balance font-display text-[clamp(36px,4.4vw,64px)] leading-[0.95] font-extrabold tracking-[-0.04em]">
      {title}
    </h2>
    <ol class="process-steps mt-10 grid list-none grid-cols-1 gap-x-10 gap-y-10 p-0 lg:mt-12 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="step" data-step={i}>
            <div class="step-tile" aria-hidden="true">
              {step.key === 'spot' && (
                <svg viewBox="0 0 100 100" class="art">
                  <line x1="6" y1="84" x2="94" y2="84" class="ln" />
                  <rect x="14" y="46" width="50" height="38" rx="2" fill="var(--color-cream)" class="ln" />
                  <rect x="10" y="36" width="58" height="12" rx="2" fill="var(--color-orange)" class="ln" />
                  <g fill="var(--color-cream)">
                    <rect x="18" y="37.5" width="6" height="9" /><rect x="31" y="37.5" width="6" height="9" /><rect x="44" y="37.5" width="6" height="9" /><rect x="57" y="37.5" width="6" height="9" />
                  </g>
                  <rect x="19" y="54" width="10" height="10" rx="1" fill="#fff" class="ln thin" />
                  <rect x="35" y="62" width="12" height="22" rx="1" fill="var(--color-blue)" class="ln" />
                  <line x1="9" y1="28" x2="5" y2="23" class="ln spark" style="--d:650ms" />
                  <line x1="22" y1="25" x2="21" y2="18" class="ln spark" style="--d:740ms" />
                  <line x1="35" y1="26" x2="38" y2="20" class="ln spark" style="--d:830ms" />
                  <g class="mag">
                    <line x1="78" y1="52" x2="91" y2="66" stroke="var(--color-espresso)" stroke-width="7" stroke-linecap="round" />
                    <circle cx="67" cy="41" r="15" fill="rgba(69,123,157,0.28)" class="ln fat" />
                    <path d="M59 36q3-6 10-6" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
                  </g>
                </svg>
              )}
              {step.key === 'plan' && (
                <svg viewBox="0 0 100 100" class="art">
                  <rect x="20" y="14" width="56" height="76" rx="6" fill="#fff" class="ln" />
                  <rect x="36" y="8" width="24" height="12" rx="3" fill="var(--color-espresso)" />
                  {rows.map((y) => (
                    <>
                      <rect x="29" y={y - 6} width="11" height="11" rx="2" fill="var(--color-cream)" class="ln thin" />
                      <line x1="46" y1={y} x2="66" y2={y} stroke="var(--color-espresso)" stroke-opacity="0.3" stroke-width="3" stroke-linecap="round" />
                    </>
                  ))}
                  {rows.map((y, r) => (
                    <path
                      d={`M30 ${y - 1}l4 4 8-9`}
                      class="tick"
                      style={`--d:${350 + r * 250}ms`}
                      fill="none"
                      stroke="var(--color-orange)"
                      stroke-width="4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  ))}
                  <g class="pencil">
                    <g transform="translate(80 66) rotate(35)">
                      <rect x="-5" y="-30" width="10" height="34" rx="1.5" fill="var(--color-orange)" class="ln thin" />
                      <rect x="-5" y="-36" width="10" height="7" rx="1.5" fill="var(--color-blue)" class="ln thin" />
                      <path d="M-5 4h10l-5 10z" fill="var(--color-cream)" class="ln thin" />
                    </g>
                  </g>
                </svg>
              )}
              {step.key === 'build' && (
                <svg viewBox="0 0 100 100" class="art">
                  <rect x="8" y="16" width="84" height="68" rx="6" fill="#fff" class="ln" />
                  <path d="M14 16h72a6 6 0 0 1 6 6v8H8v-8a6 6 0 0 1 6-6z" fill="var(--color-espresso)" />
                  <circle cx="16" cy="23" r="2.2" fill="var(--color-orange)" />
                  <circle cx="23" cy="23" r="2.2" fill="var(--color-mustard)" />
                  <circle cx="30" cy="23" r="2.2" fill="var(--color-cream)" />
                  <rect x="16" y="38" width="42" height="8" rx="2" fill="var(--color-espresso)" class="blk" style="--d:150ms" />
                  <rect x="16" y="50" width="30" height="5" rx="2" fill="var(--color-espresso)" fill-opacity="0.3" class="blk" style="--d:280ms" />
                  <rect x="63" y="38" width="21" height="26" rx="3" fill="var(--color-blue)" class="ln thin blk" style="--d:410ms" />
                  <rect x="16" y="62" width="27" height="11" rx="5.5" fill="var(--color-orange)" class="ln thin btn" />
                  <path d="M40 66v16l4.5-4.2 3.2 7 3.3-1.5-3.2-6.8h6.2z" fill="#fff" class="ln thin cur" />
                </svg>
              )}
              {step.key === 'blow' && (
                <svg viewBox="0 0 100 100" class="art">
                  <path d="M17 26v8M13 30h8" class="ln star" style="--d:700ms" />
                  <path d="M83 20v8M79 24h8" class="ln star" style="--d:820ms" />
                  <path d="M85 56v6M82 59h6" class="ln star" style="--d:940ms" />
                  <path d="M30 92a8 8 0 0 1 6-12a10 10 0 0 1 14-4a10 10 0 0 1 14 4a8 8 0 0 1 6 12z" fill="#fff" class="ln thin puff" style="--d:0ms" />
                  <g class="rocket">
                    <g class="flame">
                      <path d="M43 66q7 26 14 0z" fill="var(--color-orange)" />
                      <path d="M46.5 66q3.5 14 7 0z" fill="var(--color-mustard)" />
                    </g>
                    <path d="M38 50 27 65h11zM62 50l11 15H62z" fill="var(--color-orange)" class="ln" />
                    <path d="M50 10c12 10 14 30 12 54H38c-2-24 0-44 12-54z" fill="#fff" class="ln" />
                    <circle cx="50" cy="35" r="7" fill="var(--color-blue)" class="ln" />
                    <rect x="42" y="63" width="16" height="5" rx="1" fill="var(--color-espresso)" />
                  </g>
                </svg>
              )}
            </div>

            <div class="step-track" aria-hidden="true">
              <span class="step-node">{i + 1}</span>
              <span class="step-line"><span class="step-fill" /></span>
            </div>

            <div class="step-copy flex flex-col gap-2">
              <span class="sr-only">Step {i + 1}</span>
              <h3 class="m-0 font-display text-[30px] leading-none font-extrabold tracking-[-0.03em]">{step.title}</h3>
              <p class="m-0 max-w-[280px] text-base leading-normal">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* ---------- Finished state: what no-JS and reduced-motion visitors see ---------- */
  .process {
    --tile: 96px; /* sticker diameter; the rail's node sits level with the sticker's centre */
    --node: 32px;
    --gap-y: 40px; /* matches gap-y-10 on the list */
  }
  @media (min-width: 640px) {
    .process {
      --tile: 108px;
    }
  }
  .step-tile {
    grid-area: tile;
    display: grid;
    place-items: center;
    width: var(--tile);
    height: var(--tile);
    border-radius: 50%;
    background: var(--color-cream);
    box-shadow: 0 12px 24px rgba(25, 25, 25, 0.14);
  }
  .art {
    width: calc(var(--tile) * 0.727);
    height: calc(var(--tile) * 0.727);
    overflow: visible;
  }
  .ln {
    stroke: var(--color-espresso);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ln.thin {
    stroke-width: 2.5;
  }
  .ln.fat {
    stroke-width: 4;
  }
  /* Animated parts scale and move about their own centre. */
  .art :is(.mag, .spark, .tick, .pencil, .blk, .btn, .cur, .rocket, .puff, .star) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .flame {
    transform-box: fill-box;
    transform-origin: 50% 0;
  }

  /* Below 1024px: a vertical timeline. Rail on the left, sticker then copy on the right. */
  .step {
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    grid-template-areas:
      'track tile'
      'track copy';
    column-gap: 20px;
  }
  .step-copy {
    grid-area: copy;
    margin-top: 16px;
  }
  .step-track {
    grid-area: track;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: calc(var(--tile) / 2 - var(--node) / 2);
  }
  .step-node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    border: 3px solid var(--color-espresso);
    background: var(--color-espresso);
    color: var(--color-mustard);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    transition:
      background-color 300ms ease,
      color 300ms ease;
  }
  /* The rail runs down from this node, across the gap, to the next step's node. */
  .step-line {
    position: absolute;
    top: calc(var(--tile) / 2 + var(--node) / 2);
    bottom: calc(-1 * (var(--gap-y) + var(--tile) / 2 - var(--node) / 2));
    left: 50%;
    width: 3px;
    margin-left: -1.5px;
    background: rgba(25, 25, 25, 0.18);
    overflow: hidden;
  }
  .step:last-child .step-line {
    display: none;
  }
  .step-fill {
    position: absolute;
    inset: 0;
    background: var(--color-espresso);
    transform-origin: 50% 0;
  }

  /* 1024px and up: four columns, with one horizontal track under the stickers. */
  @media (min-width: 1024px) {
    .step {
      display: flex;
      flex-direction: column;
    }
    .step-track {
      flex-direction: row;
      height: var(--node);
      margin-top: 20px;
      padding-top: 0;
    }
    .step-line {
      top: 50%;
      bottom: auto;
      left: var(--node);
      right: 0;
      width: auto;
      height: 3px;
      margin: -1.5px 0 0;
    }
    .step:not(:last-child) .step-line {
      right: -40px;
    }
    .step:last-child .step-line {
      display: block;
    }
    .step-fill {
      transform-origin: 0 50%;
    }
  }

  /* ---------- Animated mode (the script adds .process-anim) ---------- */
  /* Below 1024px each rail segment fills downward with a transition; desktop scrubs it with scroll. */
  .process-anim .step-fill {
    transform: scaleY(var(--fill, 0));
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1) 250ms;
  }
  @media (min-width: 1024px) {
    .process-anim .step-fill {
      transform: scaleX(var(--fill, 0));
      transition: none;
    }
  }
  .process-anim .step:not(.is-on) .step-node {
    background: var(--color-mustard);
    color: var(--color-espresso);
  }
  .process-anim .step.is-on .step-node {
    animation: node-pop 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .process-anim :is(.step-tile, .step-copy) {
    transition:
      opacity 450ms ease,
      transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .process-anim .step:not(.is-on) .step-tile {
    opacity: 0.35;
    transform: scale(0.82) rotate(-8deg);
  }
  .process-anim .step:not(.is-on) .step-copy {
    opacity: 0.35;
  }

  /* Spot: the magnifier swoops in, finds the shop, sparks fly, then it hovers. */
  .process-anim .step:not(.is-on) .mag {
    transform: translate(14px, -16px) rotate(18deg);
  }
  .process-anim .is-on .mag {
    animation:
      mag-in 800ms cubic-bezier(0.34, 1.4, 0.64, 1) both,
      mag-bob 3.2s ease-in-out 900ms infinite;
  }
  .process-anim .step:not(.is-on) .spark {
    opacity: 0;
  }
  .process-anim .is-on .spark {
    animation: pop-in 420ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--d) both;
  }

  /* Plan: ticks land one by one, the pencil slides in and keeps scribbling. */
  .process-anim .step:not(.is-on) :is(.tick, .pencil) {
    opacity: 0;
  }
  .process-anim .is-on .tick {
    animation: pop-in 380ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--d) both;
  }
  .process-anim .is-on .pencil {
    animation:
      slide-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both,
      scribble 1.6s ease-in-out 1.1s infinite;
  }

  /* Build: blocks drop into the page, then the cursor arrives and keeps clicking the button. */
  .process-anim .step:not(.is-on) :is(.blk, .btn, .cur) {
    opacity: 0;
  }
  .process-anim .is-on .blk {
    animation: drop-in 520ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--d) both;
  }
  .process-anim .is-on .btn {
    animation:
      drop-in 520ms cubic-bezier(0.34, 1.56, 0.64, 1) 540ms both,
      btn-press 2.4s ease-in-out 1.7s infinite;
  }
  .process-anim .is-on .cur {
    animation:
      cursor-in 650ms cubic-bezier(0.2, 0.7, 0.2, 1) 900ms both,
      cursor-click 2.4s ease-in-out 1.7s infinite;
  }

  /* Blow up: smoke puffs, the rocket lifts off, stars twinkle, the flame keeps flickering. */
  .process-anim .step:not(.is-on) .rocket {
    transform: translateY(22px);
  }
  .process-anim .step:not(.is-on) :is(.puff, .star, .flame) {
    opacity: 0;
  }
  .process-anim .is-on .puff {
    animation: puff 900ms ease-out var(--d) both;
  }
  .process-anim .is-on .rocket {
    animation:
      lift 900ms cubic-bezier(0.34, 1.3, 0.64, 1) 150ms both,
      hover 2.6s ease-in-out 1.1s infinite;
  }
  .process-anim .is-on .flame {
    animation: flicker 180ms ease-in-out infinite alternate;
  }
  .process-anim .is-on .star {
    animation:
      pop-in 420ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--d) both,
      twinkle 2s ease-in-out calc(var(--d) + 600ms) infinite;
  }

  /* Idle loops rest while the section is off screen. */
  .process-anim:not(.in-view) .art * {
    animation-play-state: paused !important;
  }

  @keyframes node-pop {
    50% {
      transform: scale(1.25);
    }
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
  }
  @keyframes mag-in {
    from {
      transform: translate(14px, -16px) rotate(18deg);
    }
    60% {
      transform: translate(-4px, 3px) rotate(-6deg);
    }
    to {
      transform: none;
    }
  }
  @keyframes mag-bob {
    0%,
    100% {
      transform: none;
    }
    50% {
      transform: translate(-3px, -3px) rotate(-4deg);
    }
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translate(12px, 12px);
    }
  }
  @keyframes scribble {
    0%,
    100% {
      transform: none;
    }
    25% {
      transform: translate(-2px, 1px) rotate(-6deg);
    }
    75% {
      transform: translate(2px, -1px) rotate(5deg);
    }
  }
  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
  @keyframes btn-press {
    0%,
    60%,
    100% {
      transform: none;
    }
    68% {
      transform: scale(0.9);
    }
    78% {
      transform: scale(1.06);
    }
  }
  @keyframes cursor-in {
    from {
      opacity: 0;
      transform: translate(16px, 14px);
    }
  }
  @keyframes cursor-click {
    0%,
    60%,
    100% {
      transform: none;
    }
    68% {
      transform: translate(-1px, -1px) scale(0.85);
    }
  }
  @keyframes puff {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    40% {
      opacity: 1;
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes lift {
    from {
      transform: translateY(22px);
    }
  }
  @keyframes hover {
    0%,
    100% {
      transform: none;
    }
    50% {
      transform: translateY(-4px);
    }
  }
  @keyframes flicker {
    from {
      opacity: 1;
      transform: scaleY(0.82);
    }
    to {
      opacity: 1;
      transform: scaleY(1.12);
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      transform: none;
    }
    50% {
      transform: scale(0.6) rotate(45deg);
    }
  }

</style>

<script>
  import { gsap, ScrollTrigger, MOTION_OK } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('.process').forEach((section) => {
    if (!window.matchMedia(MOTION_OK).matches) return;
    const steps = Array.from(section.querySelectorAll<HTMLElement>('.step'));
    const list = section.querySelector<HTMLElement>('.process-steps');
    if (!steps.length || !list) return;

    section.classList.add('process-anim');
    new IntersectionObserver(([entry]) => section.classList.toggle('in-view', entry.isIntersecting)).observe(section);

    const setFill = (step: HTMLElement, value: number) => step.style.setProperty('--fill', String(value));
    const setOn = (step: HTMLElement, on: boolean) => step.classList.toggle('is-on', on);

    const mm = gsap.matchMedia();

    // Desktop: one track, scrubbed by scroll. Step i lights up at i/n and fills its segment until (i+1)/n.
    mm.add('(min-width: 1024px)', () => {
      const n = steps.length;
      const proxy = { p: 0 };
      const render = () => {
        steps.forEach((step, i) => {
          const local = proxy.p * n - i;
          setOn(step, local > 0.001);
          setFill(step, Math.min(1, Math.max(0, local)));
        });
      };
      const tween = gsap.to(proxy, {
        p: 1,
        ease: 'none',
        onUpdate: render,
        scrollTrigger: { trigger: list, start: 'top 85%', end: 'bottom 75%', scrub: 0.6, invalidateOnRefresh: true },
      });
      render();
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
      };
    });

    // Tablet and phone: each step lights up as it scrolls into view; CSS transitions its line to full.
    mm.add('(max-width: 1023px)', () => {
      const triggers = steps.map((step) => {
        setOn(step, false);
        setFill(step, 0);
        return ScrollTrigger.create({
          trigger: step,
          start: 'top 80%',
          onEnter: () => (setOn(step, true), setFill(step, 1)),
          onLeaveBack: () => (setOn(step, false), setFill(step, 0)),
        });
      });
      return () => triggers.forEach((t) => t.kill());
    });
  });
</script>
