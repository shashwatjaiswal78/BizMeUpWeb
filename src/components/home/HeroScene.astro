---
/**
 * Decorative hero scene: website mockup with real product photos, phone with an
 * Instagram-style grid mixing BizMeUp's social posts and brand colours, a search
 * result card and a "New enquiry" card. Images come from scripts/optimise-hero-images.mjs.
 */
import { Picture } from 'astro:assets';
import brownSlipper from '../../assets/hero/product-brown-slipper.webp';
import pinkHeels from '../../assets/hero/product-pink-heels.webp';
import crossSandal from '../../assets/hero/product-cross-sandal.webp';
import vinaDidYouKnow from '../../assets/hero/post-vina-did-you-know.webp';
import vinaLaunch from '../../assets/hero/post-vina-grand-launch.webp';
import vinaSapphire from '../../assets/hero/post-vina-bombay-sapphire.webp';
import cbdHigh from '../../assets/hero/post-sugar-island-cbd-high.webp';
import cbdPricedrop from '../../assets/hero/post-sugar-island-pricedrop.webp';
import FloatingLogos from './FloatingLogos.astro';
import iafUnplugged from '../../assets/hero/post-iaf-unplugged.webp';
import acaciaDeal from '../../assets/hero/post-acacia-best-deal.webp';
import ahllyaNumerology from '../../assets/hero/post-ahllya-what-is-numerology.webp';

const products = [brownSlipper, pinkHeels, crossSandal];

// 12 tiles: eight social posts at scattered positions, brand colours in the other four.
const grid = [
  vinaDidYouKnow, 'cream', acaciaDeal,
  'mustard', cbdHigh, vinaLaunch,
  ahllyaNumerology, cbdPricedrop, 'orange',
  iafUnplugged, 'mustard', vinaSapphire,
];
---

<!--
  One light source: every shadow falls straight down and grows with the object's height in the stack
  (--elev-1 cards, --elev-2 browser, --elev-3 phone). Tilts alternate: browser -3, phone 4, cards -3 and 2.
-->
<div aria-hidden="true" style="--elev-1:0 14px 28px rgba(25,25,25,0.18);--elev-2:0 22px 44px rgba(25,25,25,0.22);--elev-3:0 32px 60px rgba(25,25,25,0.3)" class="hero-scene relative z-[1] h-[480px] min-w-0 flex-[1_1_480px] sm:h-[560px] sm:min-w-[300px]">
  <!-- Website mockup -->
  <div
    class="absolute top-10 left-0 h-[260px] w-[86%] overflow-hidden rounded-[14px] bg-white sm:h-[310px] sm:w-[76%]"
    style="box-shadow:var(--elev-2);transform:rotate(-3deg)"
  >
    <div class="flex h-[30px] items-center gap-1.5 bg-espresso-soft px-3">
      <span class="h-[9px] w-[9px] rounded-full bg-orange"></span>
      <span class="h-[9px] w-[9px] rounded-full bg-mustard"></span>
      <span class="h-[9px] w-[9px] rounded-full bg-cream"></span>
    </div>
    <!-- Right padding keeps the nav and products clear of the phone, which overlaps this card. -->
    <div class="flex flex-col gap-3.5 py-[22px] pr-[104px] pl-6 sm:pr-[84px]">
      <div class="flex justify-between gap-3 text-[13px] text-espresso-soft">
        <span class="font-bold">yourbrand</span><span class="hidden whitespace-nowrap sm:inline">Shop / Story / Contact</span>
      </div>
      <div class="max-w-[85%] font-display text-[26px] leading-none font-extrabold tracking-[-0.03em] text-espresso sm:text-[34px]">
        Made to be noticed.
      </div>
      <div>
        <span class="inline-block rounded-full bg-orange px-3.5 py-2 text-[13px] font-semibold text-espresso">Shop now</span>
      </div>
      <div class="grid grid-cols-2 gap-2.5 max-sm:mr-5 sm:grid-cols-3">
        {
          products.map((src, i) => (
            <Picture
              src={src}
              alt=""
              widths={[120, 240]}
              sizes="(min-width: 640px) 110px, 80px"
              formats={['avif']}
              fallbackFormat="webp"
              loading="eager"
              class:list={['block h-[52px] w-full rounded-[8px] object-cover sm:h-[72px]', i === 2 && 'max-sm:hidden']}
            />
          ))
        }
      </div>
    </div>
  </div>

  <!-- Phone -->
  <div
    class="absolute top-0 right-0 h-[300px] w-[146px] overflow-hidden rounded-[28px] border-[6px] border-espresso-soft bg-espresso sm:h-[390px] sm:w-[190px] sm:rounded-[34px] sm:border-8"
    style="transform:rotate(4deg);box-shadow:var(--elev-3)"
  >
    <div class="flex items-center gap-2 px-3 pt-4 pb-2.5 text-[13px] text-cream">
      <span class="h-[26px] w-[26px] rounded-full bg-mustard"></span><span class="font-semibold">yourbrand</span>
    </div>
    <div class="grid grid-cols-3 gap-[3px] px-[3px]">
      {
        grid.map((tile) =>
          typeof tile === 'string' ? (
            <div class="h-[42px] sm:h-14" style={`background:var(--color-${tile})`} />
          ) : (
            <Picture
              src={tile}
              alt=""
              widths={[90, 180]}
              sizes="(min-width: 640px) 58px, 45px"
              formats={['avif']}
              fallbackFormat="webp"
              loading="eager"
              class="block h-[42px] w-full object-cover sm:h-14"
            />
          ),
        )
      }
    </div>
  </div>

  <!-- Search result -->
  <div
    class="absolute bottom-10 left-[2%] w-[84%] rounded-[14px] bg-white px-[18px] py-4 text-espresso-soft sm:left-[6%] sm:w-[62%]"
    style="box-shadow:var(--elev-1);transform:rotate(2deg)"
  >
    <div class="rounded-full border border-cream-deep px-3.5 py-[9px] text-sm text-muted">best jeweller near me</div>
    <div class="mt-3 flex items-center gap-2.5">
      <span class="shrink-0 rounded-[6px] bg-mustard px-2 py-1 text-xs font-bold whitespace-nowrap text-espresso">Top result</span>
      <span class="text-[15px] font-semibold whitespace-nowrap sm:text-base">Your business, on page 1</span>
    </div>
  </div>

  <!-- New enquiry -->
  <div
    class="absolute right-[4%] bottom-[150px] w-[200px] rounded-[14px] bg-mustard px-3.5 py-3 text-espresso sm:w-[230px]"
    style="transform:rotate(-3deg);box-shadow:var(--elev-1)"
  >
    <div class="text-sm font-bold">New enquiry</div>
    <div class="mt-0.5 text-sm">A customer wants a quote</div>
  </div>
  <FloatingLogos />
</div>
