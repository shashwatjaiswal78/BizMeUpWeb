---
/**
 * Spotlight hero (CLAUDE.md 4.2), on cream (orange in the brief; cream at the client's request).
 * A cream veil hides the scene except for a
 * circle of light that follows the pointer (desktop) or a drag (touch), and
 * sweeps on its own if a touch visitor does nothing for 2 seconds.
 * The first scroll, a click in the hero or any key press fades the veil out over 700ms
 * (there is no toggle button: the client found it confusing).
 * Reduced motion: no veil, scene fully visible.
 * All hero text is espresso on cream.
 */
import Button from '../ui/Button.astro';
import Sticker from '../ui/Sticker.astro';
import HeroScene from './HeroScene.astro';
import { auditHref } from '../../config/site';
---

<section
  id="top"
  class="hero relative flex flex-wrap items-end gap-12 overflow-hidden bg-cream px-5 pt-[112px] pb-16 text-espresso md:px-10 lg:px-16"
  data-lit="false"
>
  <!-- The veil is twice the hero's size with the light at its centre, and moves
       with transform so following the pointer never triggers a repaint. -->
  <div aria-hidden="true" class="hero-veil-wrap pointer-events-none absolute inset-0 z-[2] overflow-hidden">
    <div class="hero-veil absolute top-0 left-0 h-[200%] w-[200%]"></div>
  </div>

  <div class="hero-copy relative z-[3] flex max-w-[740px] flex-[1_1_560px] flex-col gap-7">
    <p aria-hidden="true" class="hero-prompt m-0 text-base font-semibold text-espresso">
      <span class="prompt-pointer">Move your cursor. Find the business.</span>
      <span class="prompt-touch">Drag to turn on the lights.</span>
    </p>

    <h1
      class="hero-title m-0 text-balance font-display text-[clamp(34px,calc((100vw_-_40px)/7.9),42px)] leading-[0.95] font-extrabold tracking-[-0.035em] text-espresso sm:text-[clamp(48px,6.2vw,92px)]"
    >
      <span class="block">Great businesses don’t fail.</span>
      <span class="block text-orange-deep">They go unseen.</span>
    </h1>

    <p class="hero-sub m-0 max-w-[520px] text-[19px] leading-normal text-balance text-espresso sm:text-[21px]">
      BizMeUp builds websites, content and campaigns that make you impossible to miss.
    </p>

    <!-- Desktop: both buttons and the sticker in one row. Phones: two equal halves side by side
         (stacked below 360px, where both labels don't fit). The sticker only shows from 1024px. -->
    <div data-hero-cta class="grid grid-cols-2 gap-3 max-[359px]:grid-cols-1 sm:flex sm:flex-wrap sm:items-center sm:gap-3.5">
      <Button href={auditHref} class="whitespace-nowrap max-sm:px-4">Book my audit</Button>
      <Button href="/#work" variant="outline" class="whitespace-nowrap max-sm:px-4">See our work</Button>
      <Sticker size={100} mobileSize={92} rotate={10} class="hero-sticker sm:ml-6 max-lg:hidden">Websites from ₹6,999</Sticker>
    </div>
  </div>

  <HeroScene />
</section>

<noscript>
  <style>
    .hero-veil-wrap,
    .hero-prompt {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .hero-veil {
    /* Light position in hero pixels, set by the script. Fallback sits over the scene on desktop. */
    --x: 69vw;
    --y: 420px;
    background: radial-gradient(
      circle 220px at 50% 50%,
      rgba(253, 246, 236, 0) 0%,
      rgba(253, 246, 236, 0) 50%,
      rgba(253, 246, 236, 0.95) 100%
    );
    transform: translate3d(calc(var(--x) - 50%), calc(var(--y) - 50%), 0);
    will-change: transform;
  }

  .hero-veil-wrap {
    transition: opacity 700ms ease;
  }
  .hero[data-lit='true'] .hero-veil-wrap {
    opacity: 0;
  }
  /* Sticker: a smaller accent than the buttons so it doesn't read as a third call to action. */
  @media (min-width: 640px) {
    .hero :global(.hero-sticker) {
      font-size: 16px;
      padding: 12px;
    }
  }

  /* The hint fades rather than collapsing, so the headline never jumps. */
  .hero-prompt {
    transition: opacity 400ms ease;
  }
  .hero[data-lit='true'] .hero-prompt {
    opacity: 0;
  }

  /* Default (mouse/trackpad): show the cursor prompt. On touch devices, show the drag
     prompt instead, matching spotlight.ts's own (hover: none) detection. */
  .prompt-touch {
    display: none;
  }
  @media (hover: none) {
    .prompt-pointer {
      display: none;
    }
    .prompt-touch {
      display: inline;
    }
  }

  /* Phones and tablets: the scene is the approved desktop composition, kept intact and scaled down
     (zoom) as a stage at the top of the hero, and the headline follows straight under it. The hint to drag sits
     over the stage while the lights are off. The hero hugs its content, so the Stat bar follows
     directly. */
  @media (max-width: 1023px) {
    .hero {
      --scene-zoom: 0.66;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
      padding-top: 66px;
      padding-bottom: 40px;
    }
    .hero :global(.hero-scene) {
      order: -1;
      flex: none;
      align-self: center;
      width: 460px;
      min-width: 0;
      /* 36px clears the logos that overhang the scene's top; the scene's own empty 40px base is
         the gap to the headline. */
      margin: 36px 0 0;
      zoom: var(--scene-zoom);
    }
    .hero-copy {
      position: static;
      flex: none;
      gap: 16px;
    }
    .hero-copy > :not(.hero-prompt) {
      position: relative;
      z-index: 3;
    }
    /* Over the stage, centred, while the lights are off. */
    .hero-prompt {
      position: absolute;
      top: calc(66px + 236px * var(--scene-zoom));
      left: 50%;
      z-index: 3;
      transform: translateX(-50%);
      padding: 8px 16px;
      border-radius: 999px;
      background: var(--color-white);
      box-shadow: var(--shadow-poster);
      font-size: 15px;
      white-space: nowrap;
      pointer-events: none;
    }
  }
  @media (min-width: 390px) and (max-width: 1023px) {
    .hero {
      --scene-zoom: 0.72;
    }
  }
  @media (min-width: 430px) and (max-width: 1023px) {
    .hero {
      --scene-zoom: 0.78;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .hero {
      --scene-zoom: 0.9;
      padding-top: 80px;
      padding-bottom: 64px;
    }
    /* On the wider canvas the stage lines up with the copy's left edge (plus the YouTube tile's overhang). */
    .hero :global(.hero-scene) {
      align-self: flex-start;
      margin-left: 16px;
    }
  }
  /* Short phones (e.g. 375x667): a smaller stage keeps both buttons on the first screen. */
  @media (max-width: 639px) and (max-height: 700px) {
    .hero {
      --scene-zoom: 0.56;
    }
  }

  /* Desktop: the hero is one screen tall (up to the designed 860px). The copy and the
     scene are centred together in the space below the nav, with room above the floating
     logos (which overhang the scene's top by ~36px). On shorter screens the headline
     scales with height and the whole scene shrinks proportionally (zoom), so the
     composition keeps its shape and its distance from the nav. */
  @media (min-width: 1024px) {
    .hero {
      --scene-zoom: 1;
      align-items: center;
      min-height: min(860px, 100svh);
      padding-top: calc(64px + clamp(40px, 7svh, 80px));
      padding-bottom: clamp(40px, 7svh, 96px);
    }
    .hero-copy {
      gap: clamp(16px, 2.8svh, 28px);
    }
    .hero-title {
      font-size: clamp(48px, min(6.2vw, 10.5svh), 92px);
    }
    .hero :global(.hero-scene) {
      height: 504px;
      /* The pieces are sized in percentages, so the scene never grows past the width it has at
         1440px; wider screens scale the whole composition instead (zoom, below). */
      max-width: 592px;
      /* Room for the logos above the scene. */
      margin-top: 76px;
      zoom: var(--scene-zoom);
    }
  }
  /* Side by side (copy 560 + scene 480 + gap + padding): margins tuned (84px over, 48px under the
     504px scene) so the hero stays one screen tall and the scene's lowest card, the search result,
     lines up with the bottom of the buttons. */
  @media (min-width: 1216px) {
    .hero :global(.hero-scene) {
      margin-top: 84px;
      margin-bottom: 48px;
    }
  }
  @media (min-width: 1024px) and (max-height: 780px) {
    .hero {
      --scene-zoom: 0.92;
    }
  }
  @media (min-width: 1024px) and (max-height: 720px) {
    .hero {
      --scene-zoom: 0.86;
    }
  }
  @media (min-width: 1024px) and (max-height: 660px) {
    .hero {
      --scene-zoom: 0.8;
    }
  }
  @media (min-width: 1024px) and (max-height: 610px) {
    .hero {
      --scene-zoom: 0.74;
    }
  }

  /* Wide screens (1600px+): the hero sits in a centred container instead of running edge to edge,
     the copy grows (headline up to 124px, still capped by screen height), and the scene keeps its
     1440px proportions, scaled up as a whole when the screen is tall enough to fit it. */
  @media (min-width: 1600px) {
    .hero {
      --hero-max: 1720px;
      justify-content: space-between;
      padding-inline: max(64px, calc((100% - var(--hero-max)) / 2));
    }
    .hero-copy {
      max-width: 920px;
    }
    .hero-title {
      font-size: clamp(48px, min(5.6vw, 11.5svh), 124px);
    }
    .hero-prompt {
      font-size: 18px;
    }
    .hero-sub {
      max-width: 600px;
      font-size: 24px;
    }
    .hero [data-hero-cta] {
      zoom: 1.12;
    }
    .hero :global(.hero-scene) {
      flex: 0 0 592px;
      /* The WhatsApp tile overhangs the scene's right edge; this evens the side margins. */
      margin-right: 28px;
    }
  }
  @media (min-width: 1600px) and (min-height: 900px) {
    .hero {
      --scene-zoom: 1.1;
    }
  }
  @media (min-width: 1900px) and (min-height: 980px) {
    .hero {
      --hero-max: 1760px;
      --scene-zoom: 1.2;
    }
  }
  @media (min-width: 2300px) and (min-height: 1150px) {
    .hero {
      --hero-max: 2000px;
      --scene-zoom: 1.4;
    }
    .hero [data-hero-cta] {
      zoom: 1.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-veil-wrap,
    .hero-prompt {
      display: none;
    }
  }
</style>

<script>
  import { initSpotlight } from '../../scripts/spotlight';
  initSpotlight();
</script>
