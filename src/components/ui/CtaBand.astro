---
/** Closing call to action for inner pages, using the approved Audit CTA copy. */
import Button from './Button.astro';
import { whatsappUrl } from '../../config/site';
---

<section class="bg-mustard px-5 py-20 text-espresso md:px-10 lg:px-16 lg:py-28">
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-end justify-between gap-10">
    <div class="flex max-w-[760px] flex-col gap-5">
      <h2 class="m-0 font-display text-[clamp(48px,6.4vw,104px)] leading-[0.9] font-extrabold tracking-[-0.045em]">
        Ready to be seen?
      </h2>
      <p class="m-0 max-w-[480px] text-[19px] leading-normal sm:text-[21px]">
        Get a free visibility audit. We'll show you exactly what's keeping you invisible, and how to fix it.
      </p>
    </div>
    <div class="flex w-full flex-col gap-3.5 sm:w-auto sm:flex-row sm:flex-wrap">
      <Button href="/contact">Book my audit</Button>
      <Button href={whatsappUrl()} variant="outline" target="_blank" rel="noopener">Chat on WhatsApp</Button>
    </div>
  </div>
</section>
