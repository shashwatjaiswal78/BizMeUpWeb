---
/** Compact case file card for the Work page and related cases. The whole tile links to the case. */
import { Picture } from 'astro:assets';
import LiveTag from './LiveTag.astro';
import { caseNumber, type CaseStudy } from '../../lib/content';

interface Props {
  entry: CaseStudy;
  serviceSlugs?: string[];
  headingLevel?: 'h2' | 'h3';
}

const { entry, serviceSlugs = [], headingLevel = 'h3' } = Astro.props;
const d = entry.data;
const Heading = headingLevel;
---

<article
  class="case-tile relative flex flex-col gap-4 rounded-[8px] bg-white p-7 text-espresso-soft transition-transform duration-300 hover:-translate-y-1 motion-reduce:transform-none sm:p-9"
  data-services={serviceSlugs.join(' ')}
>
  {
    d.mockupDesktop && (
      <div class="mb-2 rounded-[6px] bg-espresso p-[6px]">
        <LiveTag url={d.liveUrl} note={d.liveNote} class="mt-0.5 mb-[7px] ml-0.5" />
        <Picture
          src={d.mockupDesktop}
          alt=""
          widths={[480, 800, 1120]}
          sizes="(min-width: 900px) 560px, 90vw"
          formats={['avif']}
          fallbackFormat="webp"
          pictureAttributes={{ class: 'block overflow-hidden rounded-[3px] [&>img]:h-auto [&>img]:w-full' }}
        />
      </div>
    )
  }
  <span class="text-[15px] font-semibold text-orange-deep">Case {caseNumber(entry)} / {d.industry}</span>
  <Heading class="m-0 text-xl font-semibold">{d.title}</Heading>
  <p class="m-0 font-display text-[clamp(34px,3.4vw,48px)] leading-[0.95] font-extrabold tracking-[-0.035em] text-espresso">
    {d.resultHeadline}
  </p>
  <p class="m-0 text-[17px] leading-normal"><strong>The problem:</strong> {d.problem}</p>
  <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Services">
    {(d.servicesDone.length ? d.servicesDone : d.services).map((s) => <li class="rounded-full bg-espresso px-3.5 py-[7px] text-sm font-semibold text-cream">{s}</li>)}
  </ul>
  <a href={`/work/${entry.id}`} class="text-[17px] font-semibold after:absolute after:inset-0 after:content-['']">Open the case file</a>
</article>
