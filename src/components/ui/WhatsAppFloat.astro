---
import { whatsappUrl } from '../../config/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label="Chat on WhatsApp"
  class="fixed right-6 bottom-6 z-40 flex h-[60px] w-[60px] items-center justify-center rounded-full border-[1.5px] border-espresso bg-mustard shadow-float transition-transform duration-200 hover:-translate-y-0.5 motion-reduce:transform-none"
>
  <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#191919" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"></path>
  </svg>
</a>
