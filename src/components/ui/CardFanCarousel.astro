---
/**
 * Card fan carousel, ported from the 21st.dev "card-fan-carousel" React component
 * to Astro and vanilla TypeScript (GSAP only, no React). Up to 7 cards sit in a fan;
 * with more than 7, arrows, swipe and the arrow keys cycle through them. Hovering a
 * card lifts it and pushes its neighbours aside. The centre card and the hovered card
 * play their video (muted); videos load only when first played and pause off screen.
 * Reduced motion: same layout, no animation, posters only.
 */
import { Image } from 'astro:assets';
import type { ResolvedReel } from '../../config/reels';

interface Props {
  cards: ResolvedReel[];
  label?: string;
}

const { cards, label = 'Reels' } = Astro.props;

const arrow =
  'relative flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-[1.5px] border-espresso/20 bg-white text-espresso transition-colors duration-300 hover:border-espresso hover:bg-espresso hover:text-cream md:h-12 md:w-12';
---

{
  cards.length > 0 && (
    <div class="fan-carousel flex w-full flex-col items-center" data-total={cards.length}>
      <div class="fan-layout relative flex w-full max-w-[80rem] items-center justify-center" role="group" aria-roledescription="carousel" aria-label={label} tabindex="0">
        {cards.map((card) => {
          const Tag = card.linkUrl ? 'a' : 'div';
          return (
            <Tag
              class="fan-card"
              href={card.linkUrl}
              target={card.linkUrl?.startsWith('http') ? '_blank' : undefined}
              rel={card.linkUrl?.startsWith('http') ? 'noopener noreferrer' : undefined}
              data-video={card.video}
              aria-label={`${card.title} reel`}
            >
              <Image src={card.poster} alt="" widths={[300, 540].filter((w) => w <= card.poster.width)} sizes="300px" loading="lazy" class="fan-media absolute inset-0 h-full w-full object-cover" />
            </Tag>
          );
        })}
      </div>

      <div class="fan-controls z-30 mt-4 hidden items-center justify-center gap-3 sm:gap-4 md:mt-6">
        <button type="button" class={arrow} data-dir="left" aria-label="Previous reel">
          <svg aria-hidden="true" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
        </button>
        <span class="fan-counter min-w-[3.5ch] text-center text-sm font-semibold tabular-nums text-espresso/50" aria-hidden="true"></span>
        <button type="button" class={arrow} data-dir="right" aria-label="Next reel">
          <svg aria-hidden="true" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </div>
      <p class="fan-status sr-only" aria-live="polite"></p>
    </div>
  )
}

<style>
  /* Layout heights follow the original breakpoints (22, 26, 28, 34, 38rem). */
  .fan-layout {
    height: 22rem;
    outline: none;
    touch-action: pan-y;
  }
  .fan-card {
    position: absolute;
    top: 50%;
    left: 50%;
    --card-w: 9.5rem;
    width: var(--card-w);
    height: calc(var(--card-w) * 16 / 9);
    /* Centred with margins, not translate, so GSAP owns the transform. */
    margin: calc(var(--card-w) * -8 / 9) 0 0 calc(var(--card-w) / -2);
    overflow: hidden;
    border-radius: 16px;
    border: 1.5px solid var(--color-espresso);
    background: var(--color-espresso-soft);
    box-shadow: 0 18px 40px rgba(25, 25, 25, 0.22);
    opacity: 0;
    will-change: transform;
  }
  .fan-card.is-centre {
    border-color: var(--color-espresso);
    box-shadow: 0 26px 50px rgba(25, 25, 25, 0.32);
  }
  .fan-layout:focus-visible {
    outline: 3px solid var(--color-mustard);
    outline-offset: 6px;
    border-radius: 16px;
  }
  @media (min-width: 480px) {
    .fan-layout { height: 26rem; }
    .fan-card { --card-w: 11.5rem; }
  }
  @media (min-width: 640px) {
    .fan-layout { height: 28rem; }
    .fan-card { --card-w: 12.5rem; }
  }
  @media (min-width: 768px) {
    .fan-layout { height: 34rem; }
    .fan-card { --card-w: 15rem; }
  }
  @media (min-width: 1024px) {
    .fan-layout { height: 38rem; }
    .fan-card { --card-w: 17rem; }
  }
  /* Short laptop screens: keep the fan and its controls within one screen. */
  @media (min-width: 1024px) and (max-height: 760px) {
    .fan-layout { height: 30rem; }
    .fan-card { --card-w: 14rem; }
  }
</style>

<noscript>
  <style>
    .fan-card { opacity: 1; }
  </style>
</noscript>

<script>
  import { gsap } from 'gsap';
  import { prefersReducedMotion } from '../../scripts/motion';

  const MAX_VISIBLE = 7;
  const HALF = 3;
  const FAN_POSITIONS = [
    { rot: -21, scale: 0.7756, x: -30, y: 7.3, zIndex: 1 },
    { rot: -14, scale: 0.8498, x: -22, y: 4.0, zIndex: 2 },
    { rot: -7, scale: 0.9346, x: -11, y: 1.3, zIndex: 3 },
    { rot: 0, scale: 1.0, x: 0, y: 0.0, zIndex: 10 },
    { rot: 7, scale: 0.9346, x: 11, y: 1.3, zIndex: 3 },
    { rot: 14, scale: 0.8498, x: 22, y: 4.0, zIndex: 2 },
    { rot: 21, scale: 0.7756, x: 30, y: 7.3, zIndex: 1 },
  ];

  const widthMultiplier = (w: number) => (w < 480 ? 0.28 : w < 640 ? 0.38 : w < 768 ? 0.5 : w < 1024 ? 0.75 : 1);

  /** Shrinks y-offsets when the viewport is too short for the ideal layout height. */
  const heightMultiplier = (w: number) => {
    const ideal = (w < 480 ? 22 : w < 640 ? 26 : w < 768 ? 28 : w < 1024 ? 34 : 38) * 16;
    const available = window.innerHeight * 0.7;
    return available >= ideal ? 1 : available / ideal;
  };

  /** Desktop card width in px; smaller cards get proportionally smaller y-offsets so the fan stays above the controls. */
  const DESKTOP_CARD = 272;

  const slotConfig = (total: number, slot: number) => {
    if (total >= MAX_VISIBLE) return FAN_POSITIONS[slot];
    const centre = total >> 1;
    const d = total > 1 ? (slot - centre) / centre : 0;
    const a = Math.abs(d);
    return { rot: d * 21, scale: 1 - 0.2244 * a * a, x: d * 30, y: a * a * 7.3, zIndex: 10 - Math.abs(slot - centre) };
  };

  document.querySelectorAll<HTMLElement>('.fan-carousel').forEach((root) => {
    const layout = root.querySelector<HTMLElement>('.fan-layout')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.fan-card'));
    const counter = root.querySelector<HTMLElement>('.fan-counter');
    const status = root.querySelector<HTMLElement>('.fan-status')!;
    const total = cards.length;
    const paginated = total > MAX_VISIBLE;
    const slotCount = paginated ? MAX_VISIBLE : total;
    const still = prefersReducedMotion();
    const t = (seconds: number) => (still ? 0 : seconds);
    const yMult = () => heightMultiplier(window.innerWidth) * Math.min(1, cards[0].offsetWidth / DESKTOP_CARD);

    let centre = paginated ? HALF : total >> 1;
    let visible = new Map<number, number>(); // card index -> slot
    let animating = false;
    let entered = false;
    let activeSlot: number | null = null;
    let leaveTimer = 0;

    if (paginated) root.querySelector('.fan-controls')?.classList.replace('hidden', 'flex');

    const visibleMap = (c: number) => {
      const map = new Map<number, number>();
      if (!paginated) cards.forEach((_, i) => map.set(i, i));
      else for (let slot = 0; slot < MAX_VISIBLE; slot++) map.set((((c + slot - HALF) % total) + total) % total, slot);
      return map;
    };

    // Videos: created on first play, faded in over the poster once frames are ready.
    let inView = false;
    let hovered: HTMLElement | null = null;
    const play = (card: HTMLElement) => {
      const src = card.dataset.video;
      if (!src || still || !inView) return;
      let video = card.querySelector('video');
      if (!video) {
        video = Object.assign(document.createElement('video'), { src, muted: true, loop: true, playsInline: true, preload: 'auto' });
        video.setAttribute('aria-hidden', 'true');
        video.className = 'absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300';
        video.addEventListener('playing', () => video!.classList.remove('opacity-0'), { once: true });
        card.querySelector('.fan-media')?.after(video);
      }
      video.play().catch(() => {});
    };
    const pause = (card: HTMLElement) => card.querySelector('video')?.pause();
    const centreCard = () => cards[centre];
    // Browsers pause or refuse playback in background tabs; resume when the visitor comes back.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') play(centreCard());
    });

    const syncCentre = () => {
      if (counter) counter.textContent = `${centre + 1} / ${total}`;
      cards.forEach((card, i) => {
        const isCentre = i === centre;
        card.classList.toggle('is-centre', isCentre);
        // Only visible cards can be tabbed to.
        card.toggleAttribute('inert', !visible.has(i));
        if (isCentre) play(card);
        else if (card !== hovered) pause(card);
      });
      status.textContent = `Reel ${centre + 1} of ${total}`;
    };

    const render = (direction: 'left' | 'right' | null) => {
      const prev = visible;
      visible = visibleMap(centre);
      const first = !entered;
      const mult = widthMultiplier(window.innerWidth);
      const hMult = yMult();
      let done = 0;
      animating = true;
      const finish = () => {
        if (++done >= visible.size) {
          animating = false;
          entered = true;
        }
      };

      cards.forEach((card, i) => {
        const slot = visible.get(i);
        if (slot !== undefined) {
          const { x, y, rot, scale, zIndex } = slotConfig(slotCount, slot);
          const target = { x: `${x * mult}rem`, y: `${y * hMult}rem`, rotation: rot, scale, opacity: 1, zIndex };
          if (first) {
            gsap.set(card, { x: 0, y: `${12 * hMult}rem`, rotation: 0, scale: 0.5, opacity: 0 });
            gsap.to(card, { ...target, duration: t(1.2), ease: 'elastic.out(1.05,.78)', delay: t(0.2 + slot * 0.06), onComplete: finish });
          } else if (!prev.has(i)) {
            const enterX = direction === 'right' ? 40 : -40;
            gsap.set(card, { x: `${enterX * mult}rem`, y: `${y * hMult}rem`, rotation: direction === 'right' ? 30 : -30, scale: 0.5, opacity: 0 });
            gsap.to(card, { ...target, duration: t(0.6), ease: 'power2.out', onComplete: finish });
          } else {
            gsap.to(card, { ...target, duration: t(0.5), ease: 'power2.out', onComplete: finish });
          }
        } else if (prev.has(i)) {
          const exitX = direction === 'right' ? -40 : 40;
          gsap.to(card, { x: `${exitX * mult}rem`, opacity: 0, scale: 0.5, rotation: direction === 'right' ? -30 : 30, duration: t(0.4), ease: 'power2.in', zIndex: 0 });
        } else if (first) {
          gsap.set(card, { opacity: 0, scale: 0.3, x: 0, y: 0, zIndex: 0 });
        }
      });
      if (still) {
        animating = false;
        entered = true;
      }
      syncCentre();
    };

    const cycle = (direction: 'left' | 'right') => {
      if (animating || !paginated) return;
      centre = direction === 'right' ? (centre + 1) % total : (centre - 1 + total) % total;
      activeSlot = null;
      render(direction);
    };

    // Hover: lift the hovered card and push its neighbours outwards.
    const hoverLayout = (hovered: number | null) => {
      const mult = widthMultiplier(window.innerWidth);
      const hM = yMult();
      const centreSlot = visible.size >> 1;
      visible.forEach((slot, i) => {
        const el = cards[i];
        const base = slotConfig(slotCount, slot);
        let x = base.x * mult, y = base.y * hM, rot = base.rot, scale = base.scale, delay = 0;
        if (hovered !== null) {
          const distance = Math.abs(slot - hovered);
          delay = distance * 0.02;
          if (slot === hovered) {
            y -= 2.5 * hM;
            scale *= 1.08;
          } else {
            const normalised = centreSlot > 0 ? (slot - centreSlot) / centreSlot : 0;
            const push = 8 * (1 - Math.abs(normalised)) * (1 + 0.2 * Math.max(0, 3 - distance));
            const side = slot < hovered ? -1 : 1;
            x += side * push * mult;
            rot += (side * 3) / (distance + 1);
            if (slot === visible.size - 1 && hovered < centreSlot) y -= 1 * hM;
            if (slot === 0 && hovered > centreSlot) y -= 1 * hM;
          }
        } else delay = Math.abs(slot - centreSlot) * 0.02;
        gsap.to(el, { x: `${x}rem`, y: `${y}rem`, rotation: rot, scale, duration: t(0.5), delay: t(delay), ease: 'elastic.out(1,.75)', overwrite: 'auto' });
        gsap.set(el, { zIndex: base.zIndex });
      });
    };

    cards.forEach((el, i) => {
      el.addEventListener('mouseenter', () => {
        hovered = el;
        play(el);
      });
      el.addEventListener('mouseleave', () => {
        hovered = null;
        if (el !== centreCard()) pause(el);
      });
      el.addEventListener('mouseenter', () => {
        const slot = visible.get(i);
        if (animating || slot === undefined) return;
        window.clearTimeout(leaveTimer);
        if (activeSlot !== slot) {
          activeSlot = slot;
          hoverLayout(slot);
        }
      });
    });
    layout.addEventListener('mouseleave', () => {
      if (animating) return;
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        activeSlot = null;
        hoverLayout(null);
      }, 50);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
      btn.addEventListener('click', () => cycle(btn.dataset.dir as 'left' | 'right')),
    );
    layout.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') cycle('right');
      if (e.key === 'ArrowLeft') cycle('left');
    });

    // Swipe on touch screens. Pointer events, not touch events: the browser can cancel a touch
    // sequence once it starts a horizontal pan, which would drop the swipe. With touch-action
    // pan-y (see the style block) vertical scrolling stays with the page and sideways drags reach here.
    let swipeX: number | null = null;
    layout.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      swipeX = e.clientX;
    });
    layout.addEventListener('pointerup', (e) => {
      if (swipeX === null) return;
      const dx = e.clientX - swipeX;
      swipeX = null;
      if (Math.abs(dx) > 40) cycle(dx < 0 ? 'right' : 'left');
    });
    layout.addEventListener('pointercancel', () => (swipeX = null));

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        if (!animating) hoverLayout(activeSlot);
      });
    });

    // Fan out when the carousel first scrolls into view.
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) {
          cards.forEach(pause);
          return;
        }
        if (!entered && !animating) render(null);
        else play(centreCard());
      },
      { threshold: 0.25 },
    ).observe(layout);
  });
</script>
