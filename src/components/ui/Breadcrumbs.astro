---
/** Visible breadcrumb trail. BreadcrumbList structured data is added in phase 7. */
interface Props {
  items: { label: string; href?: string }[];
  tone?: 'light' | 'dark';
}

const { items, tone = 'light' } = Astro.props;
const link = tone === 'dark' ? 'text-cream hover:text-cream' : 'text-espresso hover:text-espresso';
---

<nav aria-label="Breadcrumb" class:list={['text-[15px]', tone === 'dark' ? 'text-cream/80' : 'text-muted']}>
  <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {item.href ? (
            <a href={item.href} class:list={['underline-offset-4', link]}>
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
