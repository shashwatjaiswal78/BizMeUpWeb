---
/**
 * Case file card (CLAUDE.md 4.6). Content comes from the case-studies collection.
 * The laptop shows the hero screenshot and opens the full-page viewer; the phone
 * mockup only appears when the case has a mobile screenshot.
 */
import { Picture } from 'astro:assets';
import SiteViewer from './SiteViewer.astro';
import LiveTag from './LiveTag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'case-studies'>;
  index: number;
}

const { entry, index } = Astro.props;
const d = entry.data;
const number = String(d.order).padStart(2, '0');
---

<article
  class="case-card flex w-full flex-wrap items-center gap-10 rounded-[8px] bg-white p-6 text-espresso-soft sm:p-11"
  data-case-index={index}
>
  <div class="case-text flex min-w-0 flex-[1_1_300px] flex-col gap-5">
    <span class="text-[15px] font-semibold text-orange-deep">Case {number} / {d.industry}</span>
    <h3 class="m-0 text-xl font-semibold">{d.title}</h3>
    <p
      class="case-result m-0 font-display text-[clamp(28px,2.8vw,42px)] leading-[1.02] font-extrabold tracking-[-0.03em] text-espresso"
    >
      {d.resultHeadline}
    </p>
    {
      d.stats.length > 0 && (
        <p class="m-0 text-[15px] font-semibold text-muted">{d.stats.map((s) => s.value).join(' · ')}</p>
      )
    }
    <a href={`/work/${entry.id}`} class="mt-1 text-[17px] font-semibold text-orange-deep">Open the case file &rarr;</a>
  </div>

  <div class="relative min-w-0 flex-[1.25_1_400px] self-center">
    <!-- Laptop: the screen takes the screenshot's own proportions so nothing is cropped -->
    <!-- With a phone, the laptop leaves room so the phone only overlaps its bezel, never the screenshot -->
    <div class:list={['relative', d.mockupMobile ? 'mr-[21%]' : '']}>
      <div class="mx-auto w-[92%] rounded-t-[12px] bg-espresso p-2.5">
        <LiveTag url={d.liveUrl} note={d.liveNote} class="mb-2.5" />
        {
          d.mockupDesktop ? (
            <SiteViewer
              hero={d.mockupDesktop}
              full={d.fullPage}
              client={d.title}
              url={d.liveUrl}
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 420px, 80vw"
            />
          ) : (
            <div aria-hidden="true" class="flex aspect-[16/10] w-full items-center justify-center rounded-[4px] bg-cream-deep text-sm text-espresso-soft">[Desktop mockup]</div>
          )
        }
      </div>
      <div aria-hidden="true" class="h-3.5 w-full rounded-b-[12px] bg-espresso-soft"></div>
    </div>
    {
      d.mockupMobile && (
        <div aria-hidden="true" class="absolute right-0 bottom-0 w-[24%] rounded-[18px] bg-espresso p-[5px] shadow-[0_16px_32px_rgba(25,25,25,0.25)] sm:rounded-[22px] sm:p-[6px]">
          <Picture
            src={d.mockupMobile}
            alt=""
            widths={[160, 320]}
            sizes="(min-width: 900px) 110px, 24vw"
            formats={['avif']}
            fallbackFormat="webp"
            class="block h-auto w-full rounded-[13px] sm:rounded-[16px]"
          />
        </div>
      )
    }
  </div>
</article>

<style>
  /* Desktop: scale with the window height so the whole card (problem line,
     service tags and link) stays visible while the section is pinned. */
  @media (min-width: 900px) {
    .case-card {
      padding: clamp(24px, 4.6svh, 44px);
      column-gap: clamp(24px, 3vw, 40px);
    }
    .case-text {
      gap: clamp(8px, 1.8svh, 18px);
    }
    .case-result {
      font-size: clamp(26px, min(3vw, 5svh), 42px);
    }
  }
</style>
