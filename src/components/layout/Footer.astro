---
import { nav, site } from '../../config/site';
import Logo from '../ui/Logo.astro';
import SocialIcon from '../ui/SocialIcon.astro';

const year = new Date().getFullYear();
const socials = [
  { name: 'instagram' as const, label: 'Instagram', url: site.instagram.url },
  { name: 'linkedin' as const, label: 'LinkedIn', url: site.linkedin.url },
];
---

<footer class="border-t border-espresso/20 bg-white px-5 pt-16 pb-10 text-espresso md:px-10 md:pt-24 lg:px-16">
  <div class="mx-auto flex max-w-[1312px] flex-col gap-14">
    <div class="flex flex-wrap justify-between gap-10">
      <nav aria-label="Footer" class="flex flex-wrap gap-7">
        {
          nav.map((item) => (
            <a href={item.href} class="text-[17px] text-espresso no-underline hover:text-espresso hover:underline">
              {item.label}
            </a>
          ))
        }
      </nav>
      <address class="flex flex-col gap-2 text-base text-espresso not-italic">
        <a href={`mailto:${site.email}`} class="text-espresso no-underline hover:text-espresso hover:underline">{site.email}</a>
        <a href={site.phone.href} class="text-espresso no-underline hover:text-espresso hover:underline">{site.phone.label}</a>
        <span>{site.country}</span>
        <span class="-ml-2.5 flex gap-1">
          {
            socials.map((s) =>
              s.url ? (
                <a
                  href={s.url}
                  class="inline-flex h-11 w-11 items-center justify-center text-espresso transition-transform duration-200 hover:-translate-y-0.5 hover:text-espresso motion-reduce:transform-none"
                  target="_blank"
                  rel="noopener"
                  aria-label={`BizMeUp on ${s.label}`}
                >
                  <SocialIcon name={s.name} />
                </a>
              ) : (
                <span class="inline-flex h-11 w-11 items-center justify-center text-espresso" role="img" aria-label={`${s.label} (link coming soon)`}>
                  <SocialIcon name={s.name} />
                </span>
              ),
            )
          }
        </span>
      </address>
    </div>

    <div class="text-espresso">
      <Logo class="w-full" decorative />
    </div>

    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <span class="text-lg font-semibold text-espresso">{site.tagline}</span>
      <span class="text-sm text-espresso/80">© {year} BizMeUp</span>
    </div>
  </div>
</footer>
