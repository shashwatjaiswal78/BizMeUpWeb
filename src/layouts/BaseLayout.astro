---
import '../styles/global.css';
import SEO from '../components/layout/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import Analytics from '../components/layout/Analytics.astro';
import { breadcrumbList, type Crumb } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  headerTone?: 'hero' | 'light' | 'dark';
  /** BreadcrumbList structured data for inner pages (Home first) */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
}

const { headerTone, breadcrumbs, schema = [], image = '/og/home.png', ...props } = Astro.props;
const jsonLd = [...schema, ...(breadcrumbs ? [breadcrumbList(breadcrumbs, Astro.site)] : [])];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FDF6EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO {...props} image={image} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script>
      import 'lenis/dist/lenis.css';
      import { initSmoothScroll } from '../scripts/motion';
      initSmoothScroll();
    </script>
  </body>
</html>
